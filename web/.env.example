# Copy this file to .env.local and fill in real values. .env.local is
# gitignored (matches the *.local pattern) and must never be committed.
#
# Only the anon/publishable key belongs here — it's safe for the browser
# because every table it can reach is protected by the Row Level Security
# policies in supabase/migration.sql. Never put the service-role key in a
# frontend env file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
